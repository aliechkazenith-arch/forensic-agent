# ==============================================================================
# ForensicOps AI — Environment Configuration Template (.env.example)
#
# Standards:
# - Offline / Air-Gapped by default (AGENTS.md Rule 5)
# - No hardcoded or default production secrets
# - Loopback (127.0.0.1) network binding by default
# - Strictly local evidence and artifact vault storage
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment & Security Boundary Configuration
# ------------------------------------------------------------------------------
# Deployment environment: 'development' or 'production'
ENVIRONMENT=production
FORENSICOPS_ENV=production

# Server host and port (MUST bind to loopback 127.0.0.1 for local/air-gapped security)
FORENSICOPS_HOST=127.0.0.1
FORENSICOPS_PORT=8000

# Explicit opt-in required to bind to non-loopback interfaces (default: false)
FORENSICOPS_ALLOW_EXTERNAL=false

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret for human approval authorization tokens and tamper-evident audit chains.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HUMAN_APPROVAL_HMAC_SECRET=replace_with_a_secure_random_64_character_hex_string_here

# JWT signing secret for web session authentication (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_32_plus_character_secret_key_here

# Master key or passphrase for encrypted SQLite credential vault and encrypted exports.
# Either provide a 32-byte hex/base64 string or an absolute path to a secured key file.
FORENSICOPS_CREDENTIAL_KEY=replace_with_a_secure_master_credential_encryption_key
# FORENSICOPS_CREDENTIAL_KEY_FILE=/etc/forensicops/vault.key

# ------------------------------------------------------------------------------
# 3. LLM Provider Configuration (Offline Local vs Remote)
# ------------------------------------------------------------------------------
# OPTION A: Air-Gapped Local Inference via Ollama (RECOMMENDED FOR AIR-GAPPED DEPLOYMENTS)
# OPENAI_API_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3:8b-instruct-q8_0
# MODEL_NAME=llama3:8b-instruct-q8_0
# OPENAI_API_KEY=ollama-local

# OPTION B: Air-Gapped Local Inference via LM Studio
# OPENAI_API_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=local-model
# MODEL_NAME=local-model
# OPENAI_API_KEY=lm-studio-local

# OPTION C: OpenRouter / OpenAI Compatible Endpoint (Requires Internet Connection)
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-31b-it:free
MODEL_NAME=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM execution timeout in seconds
LLM_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# 4. Storage & Forensic Vault Directories
# ------------------------------------------------------------------------------
# Directory for immutable evidence storage and .blob vaults
FORENSICOPS_VAULT_DIR=vault

# Directory for YAML forensic tool plugin cards
FORENSICOPS_PLUGINS_DIR=plugins

# Colon or comma-delimited list of directories allowed for evidence intake
FORENSICOPS_EVIDENCE_ALLOWLIST=vault,sample,evidence,data/evidence,backend/data,backend/data/evidence_intake

# Maximum evidence intake upload size in bytes (default: 10 GiB)
FORENSICOPS_MAX_UPLOAD_BYTES=10737418240

# ------------------------------------------------------------------------------
# 5. Archive Intake & Anti-Bomb Limits (ZIP / TAR / GZ)
# ------------------------------------------------------------------------------
# Maximum number of entries inside an uploaded archive
FORENSICOPS_MAX_ARCHIVE_ENTRIES=10000

# Maximum uncompressed size for a single file entry inside an archive (5 GiB)
FORENSICOPS_MAX_ARCHIVE_SINGLE_BYTES=5368709120

# Maximum uncompressed total size for entire archive extraction (20 GiB)
FORENSICOPS_MAX_ARCHIVE_TOTAL_BYTES=21474836480

# Maximum allowable decompression ratio before flagging as a potential compression bomb
FORENSICOPS_MAX_ARCHIVE_RATIO=100.0

# Maximum base64 inline evidence payload size in bytes (50 MiB)
FORENSICOPS_MAX_B64_INLINE_BYTES=52428800

# ------------------------------------------------------------------------------
# 6. Windows Registry Hive Parser Safety Bounds
# ------------------------------------------------------------------------------
# Maximum allowed registry hive file size (default: 256 MiB)
FORENSICOPS_MAX_REGISTRY_HIVE_BYTES=268435456

# Maximum registry parsing execution timeout in seconds
FORENSICOPS_MAX_REGISTRY_PARSE_SECONDS=60.0

# Maximum number of registry keys to extract per hive
FORENSICOPS_MAX_REGISTRY_KEYS=50000

# Maximum hive key recursion depth
FORENSICOPS_MAX_REGISTRY_DEPTH=60
